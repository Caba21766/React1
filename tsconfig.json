// tsconfig.json (en la raíz de React1-main)
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // JSX-transform moderno (ya no hay que importar React)
    "jsx": "react-jsx",

    // Importaciones sólo-tipo
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Estrictos y rápidos
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
